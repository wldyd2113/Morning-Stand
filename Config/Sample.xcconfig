// Sample.xcconfig — 커밋되는 템플릿. 실제 키와 서버 주소는 넣지 않는다.
// 사용법: cp Config/Sample.xcconfig Config/Secrets.xcconfig 후 값 채우기 (Secrets.xcconfig는 커밋 금지)
//
// 주의
// - xcconfig에서 `//`는 주석으로 인식된다. URL은 `https:/$()/host/path`처럼 `$()`로 끊어 적는다.
// - 공공데이터포털 키는 "Decoding" 키를 넣는다 (Alamofire가 인코딩하므로 Encoding 키를 넣으면 이중 인코딩된다).
// - 공공데이터포털 키 하나로 승인받은 모든 서비스(서울 버스, 기상청, 에어코리아)를 호출한다. 한도는 서비스별로 따로 센다.

// 공공데이터포털 (서울 버스·정류소, 기상청, 에어코리아)
DATA_GO_KR_SERVICE_KEY =

// 서울 열린데이터광장 (지하철 실시간 도착정보)
SEOUL_OPEN_DATA_SUBWAY_KEY =

// 서버 주소 (끝에 / 없이)
KMA_BASE_URL =
AIRKOREA_BASE_URL =
SEOUL_BUS_BASE_URL =
SEOUL_SUBWAY_BASE_URL =

// HTTPS를 지원하지 않는 서버의 호스트 이름 (ATS 예외)
SEOUL_BUS_HOST =
SEOUL_SUBWAY_HOST =
